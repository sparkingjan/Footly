{
  "name": "footly",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-footly --only firestore \"node --test tests/firestore.test.mjs\"",
    "test:browser": "npm run build && node scripts/run-browser-tests.mjs"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "firebase": "^12.19.0"
  }
}
